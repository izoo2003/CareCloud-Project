{
  "name": "Riley — Maple Grove Family Health",
  "firstMessage": "Hi, thanks for calling Maple Grove Family Health. I'm Riley, the clinic's virtual assistant. I can get you registered as a new patient, it only takes a few minutes. Could I start with your first and last name?",
  "firstMessageMode": "assistant-speaks-first",
  "model": {
    "provider": "custom-llm",
    "url": "https://carecloud-project.up.railway.app/llm",
    "model": "gemini-3.5-flash",
    "temperature": 0.5,
    "maxTokens": 300,
    "metadataSendMode": "variable",
    "messages": [],
    "tools": [
      {
        "type": "function",
        "async": false,
        "function": {
          "name": "lookup_patient_by_phone",
          "description": "Look up an existing patient by a 10-digit U.S. phone number. Call once as soon as the phone number is known. Returns only the name if a match exists.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": {
                "type": "string",
                "description": "U.S. phone number, 10 digits or with a leading 1"
              }
            },
            "required": ["phone_number"]
          }
        },
        "server": {
          "url": "https://carecloud-project.up.railway.app/vapi/webhook"
        }
      },
      {
        "type": "function",
        "async": false,
        "messages": [
          {
            "type": "request-start",
            "content": "One moment while I save that."
          }
        ],
        "function": {
          "name": "register_patient",
          "description": "Create a new patient record. Call ONLY after the caller has confirmed the full read-back with a clear yes.",
          "parameters": {
            "type": "object",
            "properties": {
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": {
                "type": "string",
                "description": "MM/DD/YYYY or YYYY-MM-DD"
              },
              "sex": {
                "type": "string",
                "description": "Male, Female, Other, or Decline to Answer"
              },
              "phone_number": { "type": "string" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string" },
              "address_line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": {
                "type": "string",
                "description": "2-letter U.S. state or territory code, or full state name"
              },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" }
            },
            "required": [
              "first_name",
              "last_name",
              "date_of_birth",
              "sex",
              "phone_number",
              "address_line_1",
              "city",
              "state",
              "zip_code"
            ]
          }
        },
        "server": {
          "url": "https://carecloud-project.up.railway.app/vapi/webhook"
        }
      },
      {
        "type": "function",
        "async": false,
        "messages": [
          {
            "type": "request-start",
            "content": "One moment while I save that."
          }
        ],
        "function": {
          "name": "update_patient",
          "description": "Update an existing patient after they confirm the changes. Include patient_id from lookup_patient_by_phone and only the fields that changed.",
          "parameters": {
            "type": "object",
            "properties": {
              "patient_id": {
                "type": "string",
                "description": "UUID from lookup_patient_by_phone"
              },
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string" },
              "sex": { "type": "string" },
              "phone_number": { "type": "string" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string" },
              "address_line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" }
            },
            "required": ["patient_id"]
          }
        },
        "server": {
          "url": "https://carecloud-project.up.railway.app/vapi/webhook"
        }
      },
      {
        "type": "endCall"
      }
    ]
  },
  "voice": {
    "provider": "vapi",
    "voiceId": "Savannah"
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en",
    "keyterm": ["Medicaid", "Aetna", "Riley"]
  },
  "server": {
    "url": "https://carecloud-project.up.railway.app/vapi/webhook"
  },
  "serverMessages": ["tool-calls", "end-of-call-report", "status-update"],
  "maxDurationSeconds": 900,
  "backgroundSpeechDenoisingPlan": {
    "smartDenoisingPlan": {
      "enabled": true
    }
  }
}
