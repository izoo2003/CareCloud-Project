# Runtime. Use production on Railway. development enables SIMULATE_DB_FAILURE.
APP_ENV=production

# Logging level for structured JSON stdout (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Supabase SESSION pooler (port 5432, IPv4). Scheme MUST be postgresql+asyncpg://
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional Supabase HTTP refs (FastAPI does not require these at runtime).
SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated Gemini API keys. Each key from a DIFFERENT Google Cloud project.
GEMINI_API_KEYS=

# OpenAI-compatible Gemini base URL.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Primary model (fastest current Flash-Lite). Confirm in AI Studio if names change.
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback model if the primary fails on every key.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Gemini 3.x cannot set thinking to none; low is the lowest documented level.
GEMINI_REASONING_EFFORT=low

# Per-attempt timeout when calling Gemini, in seconds.
LLM_TIMEOUT_SECONDS=8

# Sampling temperature for spoken replies.
LLM_TEMPERATURE=0.5

# Cap reply length so the agent stays to 1-2 sentences.
LLM_MAX_TOKENS=300

# Shared secret checked on /vapi/webhook and /llm/chat/completions.
VAPI_SERVER_SECRET=

# Optional. Only for a script that syncs vapi/assistant.json. Never used at runtime.
VAPI_API_KEY=

# Injected into the system prompt as the clinic name.
CLINIC_NAME=Maple Grove Family Health

# Used to compute today for date-of-birth validation.
CLINIC_TIMEZONE=America/New_York

# Test-only. Ignored unless APP_ENV=development. Keep false on Railway.
SIMULATE_DB_FAILURE=false

# Public app URL (reference only; app does not read this).
RAILWAY_PUBLIC_URL=https://carecloud-project.up.railway.app
