# Runtime environment. development enables debug helpers such as SIMULATE_DB_FAILURE.
APP_ENV=development

# Logging level for structured JSON stdout (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Supabase SESSION pooler (port 5432, IPv4). Rewrite the scheme to postgresql+asyncpg://
# URL-encode any special characters in the password (@, #, %, /).
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Comma-separated Gemini API keys. Each key must come from a DIFFERENT Google Cloud project.
GEMINI_API_KEYS=

# OpenAI-compatible Gemini base URL.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Primary model. Confirm the current Flash-Lite name in AI Studio before Phase 3.
GEMINI_MODEL=

# Fallback model if the primary fails on every key. Confirm the current Flash name in AI Studio.
GEMINI_FALLBACK_MODEL=

# Disable / minimize model "thinking" for voice latency. Drop this if the model rejects it.
GEMINI_REASONING_EFFORT=none

# Per-attempt timeout when calling Gemini, in seconds.
LLM_TIMEOUT_SECONDS=8

# Sampling temperature for spoken replies.
LLM_TEMPERATURE=0.5

# Cap reply length so the agent stays to 1-2 sentences.
LLM_MAX_TOKENS=300

# Shared secret checked on /vapi/webhook and /llm/chat/completions.
VAPI_SERVER_SECRET=

# Optional. Only for a script that syncs vapi/assistant.json. Never used at runtime.
VAPI_API_KEY=

# Injected into the system prompt as the clinic name.
CLINIC_NAME=Maple Grove Family Health

# Used to compute "today" for date-of-birth validation.
CLINIC_TIMEZONE=America/New_York

# Test-only. Ignored unless APP_ENV=development. Forces register/update writes to fail.
SIMULATE_DB_FAILURE=false
